<section class="trust wrap">
  <div>{% render 'icon', name: 'truck' %}<b>Free shipping over {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}</b><span>{{ settings.shipping_note }}</span></div>
  <div>{% render 'icon', name: 'back' %}<b>{{ settings.returns_days }}-day returns</b><span>Unworn tees, full refund</span></div>
  <div>{% render 'icon', name: 'lock' %}<b>Secure checkout</b><span>Shop Pay, Apple Pay, cards</span></div>
</section>
