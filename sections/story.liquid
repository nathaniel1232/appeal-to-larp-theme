<section class="story">
  <div class="wrap story-inner">
    <div class="story-media">{% render 'media-slot', image: section.settings.image, label: 'Image', class: 'r-45', sizes: '(min-width: 860px) 50vw, 100vw' %}</div>
    <div class="story-copy">
      <h2 class="big-quote">{{ section.settings.heading | newline_to_br }}<br><em>{{ section.settings.heading_em }}</em></h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn-ghost">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "No alarm.\nNo boss." },
    { "type": "text", "id": "heading_em", "label": "Heading last line (italic, green)", "default": "No problem." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Losing the job was the start, not the end. Mornings in the sun, afternoons in the water and time that belongs to you again." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Our story" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/pages/about" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
