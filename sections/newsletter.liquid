<section class="signup">
  <div class="wrap signup-inner">
    <h2 class="h2">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
    {%- form 'customer', class: 'email-form-wrap', id: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="thanks">You are on the list.</p>
      {%- else -%}
        <div class="email-form">
          <input type="email" name="contact[email]" required placeholder="Email address" aria-label="Email address" autocomplete="email">
          <button class="btn btn-dark">Sign up</button>
        </div>
        {%- if form.errors -%}<p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the next tee" },
    { "type": "text", "id": "heading_em", "label": "Heading end (italic, green)", "default": "first" }
  ],
  "presets": [{ "name": "Email signup" }]
}
{% endschema %}
