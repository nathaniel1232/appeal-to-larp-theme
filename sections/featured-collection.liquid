{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections.all
  endif
-%}
<section class="wrap section">
  <div class="sec-head">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <a href="{{ collection.url }}" class="link">Shop all {% render 'icon', name: 'arrow' %}</a>
  </div>
  <div class="grid">
    {%- for product in collection.products limit: section.settings.limit -%}
      {% render 'product-card', product: product %}
    {%- else -%}
      {%- for i in (1..6) -%}
        <article class="card"><div class="card-media"><div class="slot"><div class="slot-fallback"><div class="empty-art">{% render 'icon', name: 'pine' %}<span>Add products</span></div></div></div></div>
          <div class="card-info"><span>Your tee</span><span>$38</span></div></article>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The tees" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 3, "max": 24, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
