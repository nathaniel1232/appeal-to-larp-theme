<section class="hero wrap">
  <div class="hero-copy">
    <h1 class="display">{{ section.settings.heading_1 }}<br><em>{{ section.settings.heading_2 }}</em></h1>
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn-dark">{{ section.settings.button_label }} {% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </div>
  <div class="hero-media">
    {% render 'media-slot', image: section.settings.image, label: 'Hero image', class: 'r-45', sizes: '(min-width: 860px) 40vw, 100vw', eager: true %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "heading_1", "label": "Heading line 1", "default": "Unemployed." },
    { "type": "text", "id": "heading_2", "label": "Heading line 2 (italic, green)", "default": "Finally free." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Tees for people who left the 9 to 5 and got their time back. The sun, the sea and nowhere to be." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop tees" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Portrait 4:5 works best." }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
